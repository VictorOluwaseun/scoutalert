{
  "name": "@repo/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository, cache, connector, and provider implementations for ScoutAlert.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    "./discovery": {
      "types": "./dist/discovery/public.d.ts",
      "default": "./dist/discovery/public.js"
    },
    "./notifications": {
      "types": "./dist/notifications/public.d.ts",
      "default": "./dist/notifications/public.js"
    },
    "./database": {
      "types": "./dist/database/public.d.ts",
      "default": "./dist/database/public.js"
    },
    "./identity": {
      "types": "./dist/identity/public.d.ts",
      "default": "./dist/identity/public.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/public.d.ts",
      "default": "./dist/onboarding/public.js"
    },
    "./scouting": {
      "types": "./dist/scouting/public.d.ts",
      "default": "./dist/scouting/public.js"
    },
    "./scouts": {
      "types": "./dist/scouts/public.d.ts",
      "default": "./dist/scouts/public.js"
    },
    "./connections": {
      "types": "./dist/connections/public.d.ts",
      "default": "./dist/connections/public.js"
    }
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "bullmq": "6.3.9",
    "google-auth-library": "11.1.0",
    "he": "1.2.0",
    "html-to-text": "10.0.1",
    "htmlparser2": "^12.0.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "^2.5.0",
    "kysely": "0.29.6",
    "nodemailer": "10.0.12",
    "openai": "7.25.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.0",
    "playwright": "1.61.1",
    "robots-parser": "^3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "typescript": "7.0.2"
  }
}
