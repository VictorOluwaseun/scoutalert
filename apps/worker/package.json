{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file=../api/.env --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file=../api/.env --env-file-if-exists=.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@repo/adapters": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/workflows": "workspace:*",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "@types/node": "26.4.1",
    "kysely": "0.29.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.2"
  }
}
