TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
# Local startup also reads ../api/.env for DATABASE_URL, REDIS_URL and shared email settings.
# Production: supply EMAIL_PROVIDER=smtp, SMTP_HOST/PORT/SECURE/USER/PASSWORD,
# Optional backup: EMAIL_FALLBACK_ENABLED=true plus SMTP_FALLBACK_HOST/PORT/SECURE/USER/PASSWORD.
# EMAIL_FROM_ADDRESS/NAME, SCOUTALERT_WEB_ORIGIN (public HTTPS) and optional EMAIL_REPLY_TO to both hosts.
# Keep credentials in deployment secrets; local worker overrides take precedence over ../api/.env.
# Mailpit inbox link is printed only in local capture mode; separate from the SMTP address.
MAILPIT_HTTP_URL=http://localhost:8025

# Enable after running the bounded evaluation with your local key.
OPENAI_API_KEY=
SCOUT_AI_ENABLED=false
# Routine planning, source interpretation, research and private fit use mini.
SCOUT_AI_PLANNING_MODEL=gpt-5.4-mini-2026-03-17
SCOUT_AI_EXTRACTION_MODEL=gpt-5.4-mini-2026-03-17
SCOUT_AI_FIT_MODEL=gpt-5.4-mini-2026-03-17
# Selected evidence disputes, conditional eligibility and one stalled-discovery recovery use the full model.
SCOUT_AI_EXPERT_ENABLED=true
SCOUT_AI_EXPERT_MODEL=gpt-5.4-2026-03-05
# Deterministic sample of accepted and rejected private assessments (0 disables; maximum 10%).
SCOUT_AI_AUDIT_PERCENT=5
# Shared UTC daily request ceiling across worker instances; includes reserved/ambiguous attempts.
SCOUT_AI_DAILY_REQUESTS=50

# Independent input + output allowances; aliases and pinned snapshots share each family limit.
# Resets at 00:00 UTC (01:00 Africa/Lagos). Mini must have more capacity; both may be zero.
SCOUT_AI_GPT54_DAILY_TOKENS=250000
SCOUT_AI_GPT54_MINI_DAILY_TOKENS=2400000
# Protected audit allocation INSIDE the full-model limit; omitted defaults to 10% of that limit.
# Remaining 225,000 full-model tokens fund required reviews and discovery recovery.
# SCOUT_AI_AUDIT_DAILY_TOKENS=25000
# Optional additional deployment ceiling. Omit to use the sum of both family limits.
# SCOUT_AI_DAILY_TOKENS=2650000
# Maximum output per call, including reasoning (16–4000); planning retains its smaller 2000 cap.
# Mini refills at 100k/hour at 2.4M/day; one extra idle hour permits a 200k burst.
SCOUT_AI_MINI_PACING_WINDOW_MINUTES=60
# Maintenance prefers 30% while affordable discovery waits; otherwise it may borrow idle credit.
SCOUT_AI_MINI_MAINTENANCE_PERCENT=30
SCOUT_AI_MINI_CARRYOVER_MINUTES=60
# Full refills at ~10,417/hour at 250k/day; burst floor 32k accommodates an expert call.
SCOUT_AI_GPT54_PACING_WINDOW_MINUTES=60
SCOUT_AI_GPT54_CARRYOVER_MINUTES=120
# Only recently waiting active scouts compete for least-used-first turns.
SCOUT_AI_PACING_DEMAND_MINUTES=5
SCOUT_AI_MAX_OUTPUT_TOKENS=4000

# Standard-tier USD reservation ceiling; failed/ambiguous attempts retain their reserve.
SCOUT_AI_DAILY_USD=5

# Public web discovery. Add your Serper key locally before enabling; never commit credentials.
SCOUT_WEB_ENABLED=false
SERPER_API_KEY=
SCOUT_WEB_LANGUAGE=en
# Provider result locale, not applicant eligibility or a geographic product limit.
SCOUT_WEB_COUNTRY=us
# UTC daily shared attempt ceilings; failed or ambiguous requests retain reservations.
SCOUT_WEB_DAILY_REQUESTS=100
SCOUT_WEB_DAILY_USD=1
# Conservative configured reservation, not a measured provider tariff. Review against your plan.
SCOUT_WEB_REQUEST_USD=0.01
SCOUT_WEB_DAILY_DOCUMENTS=200
# Install Chromium with: pnpm --filter @repo/adapters exec playwright install chromium --only-shell
SCOUT_WEB_RENDER_ENABLED=true
SCOUT_WEB_MAX_DOCUMENTS=4
SCOUT_WEB_MAX_DEPTH=4
SCOUT_WEB_MAX_ROUNDS=8
SCOUT_WEB_MAX_SOURCE_PAGES=3
SCOUT_WEB_CONCURRENCY=2

# Reviewed public pages share revisits and the existing document/AI budgets.
# Automatic full-search interval (10–1440 minutes); source monitoring and explicit activations remain independent.
SCOUT_DISCOVERY_REFRESH_MINUTES=60
SCOUT_MONITOR_ENABLED=true
SCOUT_MONITOR_MAX_SOURCES=32

# Native public X recent search and post refresh; independent of Google/AI budgets.
# Add the app-only bearer token locally. Enabling this flag authorizes metered X reads.
SCOUT_X_ENABLED=false
X_BEARER_TOKEN=
SCOUT_X_DAILY_REQUESTS=20
SCOUT_X_DAILY_USD=1
# Conservative per returned post reservation; confirm against your X developer console.
SCOUT_X_POST_USD=0.005
SCOUT_X_PAGE_SIZE=10

# Private Gmail imports use GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REDIRECT_URI,
# and CONNECTIONS_ENCRYPTION_KEY from apps/api/.env. All four must match the API.
# An absent configuration disables mail imports. A one-minute Temporal schedule
# processes only explicitly requested label scans, with a per-owner daily cap.

# Beta settings are inherited from apps/api/.env. See docs/engineering/scoutalert-beta-launch.md.
# Additional planned AI spend: set the total to 40 to enable the approved $30 mini / $10 full split.
# Base token caps above remain unchanged. Zero disables additional paid admission.
SCOUT_AI_PAID_MONTHLY_USD=0
SCOUT_AI_PAID_MINI_MONTHLY_USD=30
SCOUT_AI_PAID_GPT54_MONTHLY_USD=10
# Required when enabled: choose the first UTC day of the repeating 30-day budget.
# SCOUT_AI_PAID_PERIOD_ANCHOR=2026-11-09
