TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
# Local startup also reads ../api/.env for DATABASE_URL and existing Mailpit settings.

# Enable after running the bounded evaluation with your local key.
OPENAI_API_KEY=
SCOUT_AI_ENABLED=false
SCOUT_AI_EXTRACTION_MODEL=gpt-5.4-mini-2026-03-17
SCOUT_AI_FIT_MODEL=gpt-5.4-mini-2026-03-17
# Shared UTC daily ceiling across worker instances; includes reserved/ambiguous attempts.
SCOUT_AI_DAILY_REQUESTS=50

# Standard-tier USD reservation ceiling; failed/ambiguous attempts retain their reserve.
SCOUT_AI_DAILY_USD=5
