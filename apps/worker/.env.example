TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
# Local startup also reads ../api/.env for DATABASE_URL, REDIS_URL and existing Mailpit settings.
# Inbox link printed once all worker queues are running; separate from the SMTP address.
MAILPIT_HTTP_URL=http://localhost:8025

# Enable after running the bounded evaluation with your local key.
OPENAI_API_KEY=
SCOUT_AI_ENABLED=false
SCOUT_AI_EXTRACTION_MODEL=gpt-5.4-mini-2026-03-17
SCOUT_AI_FIT_MODEL=gpt-5.4-mini-2026-03-17
# Shared UTC daily request ceiling across worker instances; includes reserved/ambiguous attempts.
SCOUT_AI_DAILY_REQUESTS=50

# Input + output tokens across all worker AI stages, including cached input and reasoning.
# Resets at 00:00 UTC (01:00 Africa/Lagos). Zero blocks new model calls.
SCOUT_AI_DAILY_TOKENS=100000
# Maximum output per call, including reasoning (16–4000); planning retains its smaller 2000 cap.
SCOUT_AI_MAX_OUTPUT_TOKENS=4000

# Standard-tier USD reservation ceiling; failed/ambiguous attempts retain their reserve.
SCOUT_AI_DAILY_USD=5

# Public web discovery. Add your Serper key locally before enabling; never commit credentials.
SCOUT_WEB_ENABLED=false
SERPER_API_KEY=
SCOUT_WEB_LANGUAGE=en
# Provider result locale, not applicant eligibility or a geographic product limit.
SCOUT_WEB_COUNTRY=us
# UTC daily shared attempt ceilings; failed or ambiguous requests retain reservations.
SCOUT_WEB_DAILY_REQUESTS=100
SCOUT_WEB_DAILY_USD=1
# Conservative configured reservation, not a measured provider tariff. Review against your plan.
SCOUT_WEB_REQUEST_USD=0.01
SCOUT_WEB_DAILY_DOCUMENTS=200
# Install Chromium with: pnpm --filter @repo/adapters exec playwright install chromium --only-shell
SCOUT_WEB_RENDER_ENABLED=true
SCOUT_WEB_MAX_DOCUMENTS=4
SCOUT_WEB_MAX_DEPTH=4
SCOUT_WEB_MAX_ROUNDS=8
SCOUT_WEB_MAX_SOURCE_PAGES=3
SCOUT_WEB_CONCURRENCY=2

# Reviewed public pages share revisits and the existing document/AI budgets.
SCOUT_MONITOR_ENABLED=true
SCOUT_MONITOR_MAX_SOURCES=32

# Native public X recent search and post refresh; independent of Google/AI budgets.
# Add the app-only bearer token locally. Enabling this flag authorizes metered X reads.
SCOUT_X_ENABLED=false
X_BEARER_TOKEN=
SCOUT_X_DAILY_REQUESTS=20
SCOUT_X_DAILY_USD=1
# Conservative per returned post reservation; confirm against your X developer console.
SCOUT_X_POST_USD=0.005
SCOUT_X_PAGE_SIZE=10

# Private Gmail imports use GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REDIRECT_URI,
# and CONNECTIONS_ENCRYPTION_KEY from apps/api/.env. All four must match the API.
# An absent configuration disables mail imports. A one-minute Temporal schedule
# processes only explicitly requested label scans, with a per-owner daily cap.
