# Copy this file to .env for local API development. Process environment wins.
# API listener port. The default is 4040.
PORT=4040

# Local Mailpit SMTP listener; its inbox normally runs at http://localhost:8025.
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@scoutalert.test
EMAIL_FROM_NAME=ScoutAlert

# Separate application database; run pnpm --filter api db:migrate before starting.
DATABASE_URL=postgresql://scoutalert:replace-me@127.0.0.1:5432/scoutalert
REDIS_URL=redis://127.0.0.1:6379
# Generate two independent private keys with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IDENTITY_SECRET=
# Must equal WEB_API_SECRET in apps/web/.env.local. Never use NEXT_PUBLIC_ for this key.
WEB_API_SECRET=

# NestJS Observe is enabled when both credentials are set.
# Keep both empty to run without Observe. Service ID defaults to api.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api
