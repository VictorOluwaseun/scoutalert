# Copy this file to .env for local API development. Process environment wins.
# API listener port. The default is 4040.
PORT=4040

# Shared email configuration for API sign-in codes and worker opportunity alerts.
# mailpit is local-only. Production requires smtp, verified sender identity and TLS credentials.
EMAIL_PROVIDER=mailpit
# Website origin used by email buttons and alert settings. SMTP mode requires your public HTTPS origin.
SCOUTALERT_WEB_ORIGIN=http://localhost:3030
# Local Mailpit SMTP listener; its inbox normally runs at http://localhost:8025.
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@scoutalert.test
EMAIL_FROM_NAME=ScoutAlert
# Optional real mailbox for replies. Leave empty to omit Reply-To.
EMAIL_REPLY_TO=
# Production SMTP: obtain these settings from your transactional email provider.
# Set EMAIL_PROVIDER=smtp and replace EMAIL_FROM_ADDRESS with a verified domain address.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# false means REQUIRED STARTTLS; use true with port 465 for implicit TLS.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# See docs/engineering/scoutalert-production-email.md for setup and verification.

# Separate application database; run pnpm --filter api db:migrate before starting.
DATABASE_URL=postgresql://scoutalert:replace-me@127.0.0.1:5432/scoutalert
REDIS_URL=redis://127.0.0.1:6379
# Generate two independent private keys with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IDENTITY_SECRET=
# Must equal WEB_API_SECRET in apps/web/.env.local. Never use NEXT_PUBLIC_ for this key.
WEB_API_SECRET=

# NestJS Observe is enabled when both credentials are set.
# Keep both empty to run without Observe. Service ID defaults to api.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api

# Optional Gmail source connection. Set all four together; keep empty to disable.
# Enable Gmail API and create a Google OAuth Web application, then add this exact callback.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Local callback: http://localhost:3030/api/connections/gmail/callback
# Independent 32-byte hex encryption key. Back it up securely; never reuse identity/transport keys.
CONNECTIONS_ENCRYPTION_KEY=

# Shared beta settings. The worker inherits this file; enable after beta:check passes.
SCOUT_BETA_ENABLED=false
SCOUT_BETA_MAX_ACCOUNTS=50
SCOUT_BETA_ACTIVE_SCOUTS=1
SCOUT_BETA_REFRESH_MINUTES=1440
SCOUT_BETA_DISPATCH_BATCH=2
SCOUT_BETA_DISPATCH_INTERVAL_MINUTES=25
# Per-account maximums, shared across replacements/revisions and both funding sources.
# These are ceilings, not guaranteed entitlements from the shared deployment pools.
SCOUT_BETA_MINI_ACCOUNT_TOKENS=80000
SCOUT_BETA_GPT54_ACCOUNT_TOKENS=20000
