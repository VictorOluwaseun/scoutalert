# Server-only API origin used by Next.js route handlers.
# Development falls back to this URL when the variable is unset.
SCOUTALERT_API_URL=http://127.0.0.1:4040
# Same private key configured in apps/api/.env. Never expose this through NEXT_PUBLIC_.
WEB_API_SECRET=
SCOUTALERT_WEB_ORIGIN=http://localhost:3030
# Enable only behind an edge that overwrites x-forwarded-for; false uses a shared network bucket.
SCOUTALERT_TRUST_PROXY=false
